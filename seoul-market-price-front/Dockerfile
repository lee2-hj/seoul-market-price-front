FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ARG VITE_KAKAO_MAP_JAVASCRIPT_KEY
ARG VITE_PORTONE_SDK_SRC
ARG VITE_PORTONE_STORE_ID
ARG VITE_PORTONE_CHANNEL_KEY
ENV VITE_KAKAO_MAP_JAVASCRIPT_KEY=$VITE_KAKAO_MAP_JAVASCRIPT_KEY
ENV VITE_PORTONE_SDK_SRC=$VITE_PORTONE_SDK_SRC
ENV VITE_PORTONE_STORE_ID=$VITE_PORTONE_STORE_ID
ENV VITE_PORTONE_CHANNEL_KEY=$VITE_PORTONE_CHANNEL_KEY
RUN npm run build
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]